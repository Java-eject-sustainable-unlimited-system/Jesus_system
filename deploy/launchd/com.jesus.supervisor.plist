<?xml version="1.0" encoding="UTF-8"?>
<!-- Install: cp to ~/Library/LaunchAgents/, adjust paths, then
     launchctl load ~/Library/LaunchAgents/com.jesus.supervisor.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.jesus.supervisor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/java</string>
        <string>-cp</string>
        <string>/opt/jesus/jesus-watchdog-agent-1.0.0.jar</string>
        <string>com.jesus.system.supervisor.ExternalSupervisor</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SUPERVISOR_WATCHDOG_RESTART_CMD</key>
        <string>/bin/launchctl kickstart -k gui/501/com.jesus.watchdog</string>
    </dict>
    <key>WorkingDirectory</key><string>/opt/jesus</string>
    <!-- launchd relaunches the supervisor JVM if it exits. -->
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
</dict>
</plist>
